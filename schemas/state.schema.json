{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forge.dev/schemas/state.schema.json",
  "title": "State",
  "description": "One of four perspectives on a resource's state: OBSERVED, DESIRED, PLANNED, VERIFIED.",
  "type": "object",
  "required": ["resource", "perspective", "attributes", "recorded_at"],
  "properties": {
    "resource": { "type": "string", "description": "Resource id this state describes" },
    "perspective": {
      "type": "string",
      "enum": ["OBSERVED", "DESIRED", "PLANNED", "VERIFIED"]
    },
    "attributes": { "type": "object", "additionalProperties": true },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
